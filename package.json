{
  "name": "gabriels-monster-arena",
  "version": "1.0.0",
  "description": "A tower defense game built with HTML5 Canvas and JavaScript",
  "main": "js/main.js",
  "scripts": {
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:performance": "jest tests/performance",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:debug": "jest --runInBand --no-cache",
    "start": "python -m http.server 8000",
    "build": "npm run build:prod",
    "build:prod": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "lint": "eslint js/**/*.js tests/**/*.js",
    "lint:fix": "eslint js/**/*.js tests/**/*.js --fix",
    "format": "prettier --write js/**/*.js tests/**/*.js",
    "analyze": "npm run build:prod && webpack-bundle-analyzer dist/bundle.js",
    "serve": "python -m http.server 8000",
    "dev": "npm run serve"
  },
  "keywords": [
    "tower-defense",
    "html5",
    "canvas",
    "javascript",
    "game",
    "mobile",
    "ecs"
  ],
  "author": "Gabriel's Monster Arena Team",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/user-event": "^14.5.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.53.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^27.0.1",
    "prettier": "^3.0.0",
    "webpack": "^5.89.0",
    "webpack-bundle-analyzer": "^4.9.0",
    "webpack-cli": "^5.1.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
